    "start": "tsx src/bin/worker.ts",
    "dev": "tsx watch src/bin/worker.ts"
  },
  "dependencies": {
    "@cc/config": "workspace:*",
    "@cc/db": "workspace:*",
    "@cc/domain": "workspace:*",
    "@cc/service-notification": "workspace:*",
    "@cc/service-payment": "workspace:*",
    "@cc/service-sap": "workspace:*",
    "@cc/service-support": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
