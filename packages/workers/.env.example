# Copy to .env for local development of the worker process.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customerconnect?schema=public"

# BullMQ broker — the Redis from docker-compose.dev.yml.
REDIS_URL="redis://localhost:6379"

# How often the outbox relay sweeps, in milliseconds.
OUTBOX_POLL_INTERVAL_MS="2000"

# Rows claimed per tenant per sweep. Bounds one slow tenant's blast radius.
OUTBOX_BATCH_SIZE="100"

# Relay attempts before a row is parked in `failed` for the exception tray.
OUTBOX_MAX_ATTEMPTS="5"

# Jobs a single worker runs at once, per queue.
WORKER_CONCURRENCY="5"

# How often the SLA sweep looks for newly-breached tickets. Minutes, not
# seconds: an SLA is measured in hours (ADR-029).
SLA_SWEEP_INTERVAL_MS="60000"
