# Copy to .env for local development of the worker process.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customerconnect?schema=public"

# Envelope-encryption master key for the tenant credential vault (docs/DECISIONS.md
# ADR-042). The payment-posting retry handler resolves a tenant's SAP adapter,
# same as the web app — must match apps/web's value for a shared DB. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_MASTER_KEY="h/z4mreBytBcGVc6Qak/dgptjhndgszbTQqZUp7CEU0="
CREDENTIAL_MASTER_KEY_PROVIDER="env"

# BullMQ broker — the Redis from docker-compose.dev.yml.
REDIS_URL="redis://localhost:6379"

# How often the outbox relay sweeps, in milliseconds.
OUTBOX_POLL_INTERVAL_MS="2000"

# Rows claimed per tenant per sweep. Bounds one slow tenant's blast radius.
OUTBOX_BATCH_SIZE="100"

# Relay attempts before a row is parked in `failed` for the exception tray.
OUTBOX_MAX_ATTEMPTS="5"

# Jobs a single worker runs at once, per queue.
WORKER_CONCURRENCY="5"

# How often the SLA sweep looks for newly-breached tickets. Minutes, not
# seconds: an SLA is measured in hours (ADR-029).
SLA_SWEEP_INTERVAL_MS="60000"

# Notification delivery (@cc/adapter-notifications, A7). "log" writes each
# message to the console and needs nothing external; "email" POSTs to a
# transactional-email provider. The bell inbox is written either way.
NOTIFICATIONS_DRIVER="log"
# NOTIFICATIONS_EMAIL_ENDPOINT="https://api.provider.example/v1/send"
# NOTIFICATIONS_EMAIL_API_KEY=""
# NOTIFICATIONS_FROM_EMAIL="no-reply@customerconnect.example"
# NOTIFICATIONS_FROM_NAME="CustomerConnect"

# Used to build the link in a notification email: <slug>.<ROOT_DOMAIN>. With
# no ROOT_DOMAIN a mail carries no link rather than a guessed one.
ROOT_DOMAIN="localhost"
PORTAL_PORT="3000"

# Observability (@cc/observability, docs/07 B3). All optional/defaulted.
LOG_LEVEL="info"
OTEL_SERVICE_NAME="customer-portal-workers"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
# SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
