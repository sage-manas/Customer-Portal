// Phase 0 scope: cross-cutting tenancy tables + the two modules with a
// domain registry so far (Onboarding, Order). See docs/02-TRD-ARCHITECTURE.md
// §7 for the full target data model; other modules' tables are added as
// their phases begin (docs/04-ROADMAP-ZERO-TO-PRODUCTION.md).
//
// Tenancy model: row-level `tenantId` + Prisma middleware (docs/DECISIONS.md
// ADR-003) — every tenant-owned model below carries `tenantId`.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SapDriver {
  mock
  ecc
  s4
}

enum GstnDriver {
  mock
  api
}

enum PaymentGatewayDriver {
  mock
  razorpay
}

/// Portal-side payment state (@cc/domain entities/payment.ts). Deliberately
/// not a CanonicalStatus: those describe SAP documents, and a payment only
/// becomes one at `posted`. `captured` vs `posted` is the window where money
/// has been taken but SAP hasn't cleared the items yet — the reason payments
/// are stored at all when orders and invoices are not (ADR-019).
enum PaymentState {
  initiated
  captured
  posted
  failed
  cancelled
}

model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  customDomain String?  @unique
  sapDriver    SapDriver @default(mock)
  /// GSTIN verification driver (docs/03 Screen 1.2); mock until a tenant
  /// has real GSTN API credentials.
  gstnDriver   GstnDriver @default(mock)
  /// Payment gateway (docs/03 Screen 7.2); mock until a tenant has real
  /// gateway credentials.
  paymentGateway PaymentGatewayDriver @default(mock)
  /// Branding (docs/05 P6): tenants change logo + primary color, not layout.
  logoUrl      String?
  primaryColor String?
  /// Module toggles keyed by NavItem.key (@cc/domain navigation registry).
  /// Absent key = enabled; tenants opt modules *out*.
  moduleToggles Json    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               User[]
  onboardingApps      OnboardingApplication[]
  salesOrders         SalesOrder[]
  payments            Payment[]
  auditLogs           AuditLog[]

  @@map("tenants")
}

enum UserRole {
  platform_operator
  tenant_admin
  tenant_sales
  tenant_credit
  tenant_support
  buyer_admin
  buyer_user
  buyer_view_only
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  /// One user may hold several roles; the JWT carries them all as claims
  /// (docs/02 §3). Permissions are derived from roles in @cc/domain/auth.
  roles     UserRole[]
  /// scrypt hash, format "scrypt$N$r$p$salt$hash" (see @cc/service-identity).
  /// Null for users provisioned before their credentials are issued.
  passwordHash String?
  isActive  Boolean  @default(true)
  /// docs/05 §8: first-login forced password change.
  mustChangePassword Boolean @default(false)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())

  accountLinks UserAccountLink[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/** One user may act for multiple SAP sold-to accounts (KUNNR). */
model UserAccountLink {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  sapKunnr String

  @@unique([tenantId, userId, sapKunnr])
  @@index([tenantId])
  @@map("user_account_links")
}

enum OnboardingStatus {
  draft
  submitted
  pending_approval
  approved
  rejected
}

model OnboardingApplication {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  status           OnboardingStatus  @default(draft)
  /// Shape validated against onboardingWriteSchema (@cc/domain). Partial
  /// while the wizard is in progress; complete from `submitted` onwards.
  data             Json
  /// Unguessable bearer handle for the applicant, who has no session until
  /// their account is created at approval (docs/DECISIONS.md ADR-009).
  draftToken       String
  /// Denormalized out of `data` purely so they can be indexed: the dupe
  /// guard and the reviewer queue both search on them.
  contactEmail     String?
  gstin            String?
  /// GSTN verification evidence, captured at verify time (ADR-010).
  /// Shape: GstinVerification (@cc/domain).
  gstinVerification Json?
  /// Internal approval fields (docs/03 Screen 1.4), set by the reviewer.
  salesOrg            String?
  distributionChannel String?
  creditApprovalStatus String?
  sapCustomerCode  String?
  rejectionReasons String[]
  /// Reviewer's note on a Request More Info / Reject decision.
  reviewNote       String?
  decidedByUserId  String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  documents OnboardingDocument[]
  events    OnboardingEvent[]

  @@unique([tenantId, draftToken])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, gstin])
  @@map("onboarding_applications")
}

model OnboardingDocument {
  id            String                @id @default(cuid())
  tenantId      String
  applicationId String
  application   OnboardingApplication @relation(fields: [applicationId], references: [id])
  /// panCardCopy | gstCertificate | incorporationCert
  kind          String
  storageKey    String
  fileName      String
  contentType   String
  sizeBytes     Int
  uploadedAt    DateTime              @default(now())

  /// One document per kind: re-uploading replaces rather than accumulating.
  @@unique([tenantId, applicationId, kind])
  @@index([tenantId])
  @@map("onboarding_documents")
}

/// Append-only workflow timeline — what `/register/status` renders
/// (docs/05 §7.1: Submitted -> Under review -> Approved/Rejected).
model OnboardingEvent {
  id            String                @id @default(cuid())
  tenantId      String
  applicationId String
  application   OnboardingApplication @relation(fields: [applicationId], references: [id])
  status        OnboardingStatus
  note          String?
  /// Null for applicant-driven events — they have no portal user yet.
  actorUserId   String?
  createdAt     DateTime              @default(now())

  @@index([tenantId])
  @@index([tenantId, applicationId])
  @@map("onboarding_events")
}

/// Catalogue cart (docs/05 §7.2). Portal-owned staging area — SAP has no
/// cart, so this is one of the few tables holding transactional data of its
/// own. Scoped to a sold-to account rather than a user: colleagues on the
/// same KUNNR build one basket, and the split CTA (Request Quote vs Create
/// Order) may be exercised by whichever of them holds the permission.
model Cart {
  id            String   @id @default(cuid())
  tenantId      String
  customerKunnr String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines CartLine[]

  /// One open cart per account, which is what makes add-to-cart idempotent.
  @@unique([tenantId, customerKunnr])
  @@index([tenantId])
  @@map("carts")
}

/// A prospective order line. Price and stock are deliberately NOT stored:
/// they are per-customer SAP reads that go stale, so the service reprices
/// on every read (docs/05 P1 — the UI is honest about freshness).
model CartLine {
  id       String   @id @default(cuid())
  tenantId String
  cartId   String
  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  material String
  quantity Decimal
  addedAt  DateTime @default(now())

  /// Adding a material already in the cart updates its quantity.
  @@unique([tenantId, cartId, material])
  @@index([tenantId])
  @@map("cart_lines")
}

/// Portal-owned order drafts, and the submission record of what each one
/// became. SAP owns submitted sales orders, so nothing here is read back as
/// an order's current state — `getOrder` in @cc/service-order always asks
/// SAP (docs/05 P1). Keyed to the sold-to account rather than the user, like
/// the cart (ADR-014): a buyer stages, a colleague submits.
model SalesOrder {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  customerKunnr String
  /// SAP VBAK-VBELN once created; null while portal-only draft
  soNumber      String?
  /// "Draft" until submitted, then "Submitted". The statuses SAP returned at
  /// submission time, kept as a record of the submission — never as a cache.
  orderStatus   String
  creditStatus  String
  /// Shape validated against orderHeaderWriteSchema (@cc/domain)
  header        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines SalesOrderLine[]

  @@unique([tenantId, soNumber])
  @@index([tenantId])
  /// The drafts list and the account's submission history both read on this.
  @@index([tenantId, customerKunnr, orderStatus])
  @@map("sales_orders")
}

model SalesOrderLine {
  id       String     @id @default(cuid())
  tenantId String
  orderId  String
  order    SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNo   Int
  material String
  quantity Decimal
  uom      String
  price    Decimal?
  plant    String?

  @@index([tenantId])
  @@map("sales_order_lines")
}

/// A customer payment against open invoices (docs/03 Screen 7.2, docs/02 §6).
///
/// This is the one O2C document the portal genuinely owns, and the exception
/// to ADR-016's "SAP owns it, so don't mirror it": between the gateway
/// capturing money and SAP clearing the items there is a real debit against
/// a real customer that no FI document yet accounts for. Losing that window
/// means losing the only record that the money was taken (ADR-019).
///
/// Once `posted`, the SAP fields below are the *record of the posting*, not a
/// cache: the statement is always re-read from BSID, never from here.
model Payment {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  /// Sold-to account the payment is for — the security boundary, like the
  /// cart and drafts (ADR-014).
  customerKunnr String
  /// Who pressed Pay. Kept for the audit trail; the payment belongs to the
  /// account, so a colleague can see it on the statement.
  initiatedByUserId String?
  amount        Decimal
  currency      String   @default("INR")
  /// UPI / NEFT / Card / NetBanking (@cc/domain PAYMENT_MODES).
  mode          String
  state         PaymentState @default(initiated)
  /// BSEG-KIDNO — the gateway's reference. Unique per tenant: it is the
  /// idempotency key that stops a replayed webhook posting twice.
  gatewayReference String?
  /// FI document from the F-28 equivalent posting, once cleared in SAP.
  fiDocumentNumber String?
  /// Gateway's own failure text. Logged and shown to the back office; the
  /// customer reads the translated copy instead (docs/05 §11).
  failureReason String?
  /// Last webhook event applied, so an at-least-once redelivery of the same
  /// event is recognised and ignored (docs/02 §6: idempotent webhooks).
  lastEventId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  postedAt      DateTime?

  allocations PaymentAllocation[]

  @@unique([tenantId, gatewayReference])
  /// A webhook may only ever be applied once, however many times it arrives.
  @@unique([tenantId, lastEventId])
  @@index([tenantId])
  @@index([tenantId, customerKunnr, state])
  @@map("payments")
}

/// How a payment was split across open items (BSID-BELNR). Partial payments
/// are supported, so the allocated amount may be less than the item's
/// balance — SAP then leaves a residual open item (docs/02 §6).
model PaymentAllocation {
  id             String  @id @default(cuid())
  tenantId       String
  paymentId      String
  payment        Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// BSID-BELNR of the invoice being settled.
  documentNumber String
  amount         Decimal
  /// Set once SAP confirms: was this item fully cleared, or left residual?
  cleared        Boolean @default(false)

  @@unique([tenantId, paymentId, documentNumber])
  @@index([tenantId])
  @@map("payment_allocations")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("audit_log")
}
