# Copy to .env.local for local development of the operator console.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customerconnect?schema=public"

# HS256 signing key for operator session tokens. Deliberately a DIFFERENT
# secret from apps/web's AUTH_SECRET (docs/DECISIONS.md ADR-045) — sharing one
# would undo the point of a separate realm. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OPS_AUTH_SECRET="replace-with-a-random-32+-character-secret"
