# Copy to .env.local for local development.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/customerconnect?schema=public"

# Envelope-encryption master key for the tenant credential vault (docs/DECISIONS.md
# ADR-042) — base64, must decode to 32 bytes. Only matters once a tenant is
# switched off the mock SAP/GSTN/payment drivers; every route that resolves
# a real adapter reads a decrypted credential through this. Generate a dev
# value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_MASTER_KEY="h/z4mreBytBcGVc6Qak/dgptjhndgszbTQqZUp7CEU0="
CREDENTIAL_MASTER_KEY_PROVIDER="env"

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-at-least-32-chars"

# Apex domain; tenants are <slug>.<ROOT_DOMAIN>, e.g. acme.localhost:3000
ROOT_DOMAIN="localhost"

# Tenant used when the host has no subdomain (bare localhost:3000).
# Leave unset in production, where the host must resolve a tenant.
DEFAULT_TENANT_SLUG="acme"

# Object storage for onboarding documents (@cc/adapter-storage).
# "memory" keeps uploads in-process (fine for tests); "local" writes them
# under STORAGE_ROOT so they survive a dev-server restart.
STORAGE_DRIVER="local"
STORAGE_ROOT=".storage"

# Report cache (@cc/adapter-cache, ADR-036). Reports are cache-aside; a hit
# is rendered as "cached" with the original SAP sync time, never as live.
# Unset REDIS_URL and the memory driver is used, which is correct for a
# single dev process. Set REPORT_CACHE_DRIVER="memory" to force it off.
# REDIS_URL="redis://localhost:6379"

# Notifications (@cc/adapter-notifications, A7). The web app only *reads* the
# bell inbox — the fan-out and any email happen in @cc/workers — so this is
# here for completeness; configure it in packages/workers/.env.
NOTIFICATIONS_DRIVER="log"

# Observability (@cc/observability, docs/07 B3). All optional/defaulted —
# unset and the app still runs, logging structured JSON to stdout with no
# tracing or error reporting.
LOG_LEVEL="info"
OTEL_SERVICE_NAME="customer-portal-web"
# Unset: spans print to the console. Set to a real OTLP/HTTP collector to
# actually ship them.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"
# Unset: captureException() is a no-op. Set to enable Sentry.
# SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Which cache driver /api/health round-trips to answer "is the cache
# reachable" (@cc/service-health) — matches whatever @cc/service-reporting
# is actually configured with. "redis" needs REDIS_URL, above.
CACHE_DRIVER="memory"
